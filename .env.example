# Create a PostgreSQL database named routeback before starting the server.
ROUTEBACK_DB_URL=postgresql+psycopg://postgres:root@localhost:5432/RouteBack
HOST=127.0.0.1
PORT=3080
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
COOKIE_HTTPS_ONLY=0
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=RouteBack Administrator
INITIAL_ADMIN_PASSWORD=replace-with-8-to-12-letters-and-numbers
UPLOAD_DIR=./private_uploads
CORS_ORIGINS=http://localhost:3080
